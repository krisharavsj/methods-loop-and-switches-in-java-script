"06_my_study_progress_dashboard.html": r'''<!DOCTYPE html>
<html>
<head>
    <title>My Study Progress Dashboard</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>

<div class="container py-4">

    <div class="p-5 bg-primary text-white rounded mb-4">
        <h1>My Study Progress Dashboard</h1>
        <p>Track your learning progress and subjects.</p>
    </div>

    <div class="mb-4">
        <button class="btn btn-primary m-1">Maths</button>
        <button class="btn btn-success m-1">Science</button>
        <button class="btn btn-warning m-1">English</button>
        <button class="btn btn-info m-1">Computer Science</button>
    </div>

    <div class="row g-4">

        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h3>Maths <span class="badge bg-primary">12 lessons</span></h3>
                    <p>Progress</p>
                    <div class="progress">
                        <div class="progress-bar" style="width: 80%;">80%</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h3>Science <span class="badge bg-success">10 lessons</span></h3>
                    <p>Progress</p>
                    <div class="progress">
                        <div class="progress-bar bg-success" style="width: 65%;">65%</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h3>English <span class="badge bg-warning text-dark">8 lessons</span></h3>
                    <p>Progress</p>
                    <div class="progress">
                        <div class="progress-bar bg-warning text-dark" style="width: 70%;">70%</div>
                    </div>
