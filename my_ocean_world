        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h3>Computer Science <span class="badge bg-info">15 lessons</span></h3>
                    <p>Progress</p>
                    <div class="progress">
                        <div class="progress-bar bg-info" style="width: 90%;">90%</div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

</body>
</html>